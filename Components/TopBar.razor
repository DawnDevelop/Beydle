<header class="topbar">
    <div class="brand">
        <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 48 48" width="30" height="30">
                <path fill="#fff" fill-rule="evenodd" d="M24 7 Q30.14 2.87 35.79 5.42 L36.02 11.98 Q43.28 13.4 45.47 19.2 L41 24 Q45.13 30.14 42.58 35.79 L36.02 36.02 Q34.6 43.28 28.8 45.47 L24 41 Q17.86 45.13 12.21 42.58 L11.98 36.02 Q4.72 34.6 2.53 28.8 L7 24 Q2.87 17.86 5.42 12.21 L11.98 11.98 Q13.4 4.72 19.2 2.53 L24 7 Z M24 13.5 A10.5 10.5 0 1 0 24 34.5 A10.5 10.5 0 1 0 24 13.5 Z" />
                <circle cx="24" cy="24" r="7" fill="#fff" opacity=".35" />
                <circle cx="24" cy="24" r="3" fill="#fff" />
            </svg>
        </span>
        <h1>Beydle</h1>
    </div>
    <div class="topbar-actions">
        @if (Streak is int streak)
        {
            <button class="streak-badge" title="@streak-day streak" aria-label="@streak-day streak"  @onclick="OnStats">🔥 @streak <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24"><path fill="currentColor" d="m16 6l2.29 2.29l-4.88 4.88l-4-4L2 16.59L3.41 18l6-6l4 4l6.3-6.29L22 12V6z" /></svg></button>
        }
        <button class="icon-btn" title="How to play" aria-label="How to play" @onclick="OnHelp">?</button>
    </div>
</header>

@code {
    /// <summary>The current streak; null hides the badge (while the game is loading).</summary>
    [Parameter] public int? Streak { get; set; }
    [Parameter] public EventCallback OnStats { get; set; }
    [Parameter] public EventCallback OnHelp { get; set; }
}

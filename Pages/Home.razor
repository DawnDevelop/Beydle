@page "/"
@implements IDisposable
@inject BladeService Blades
@inject StorageService Storage
@inject ShareService Sharing
@inject GuessReporter Reporter
@inject NavigationManager Nav

<PageTitle>Beydle - daily Beyblade X guessing game</PageTitle>

<TopBar Streak="@(games is null ? null : StatsTracker.CurrentStreak(games.Stats, games.Today))"
        OnStats="() => OpenDialog(Dialog.Stats)"
        OnHelp="() => OpenDialog(Dialog.Help)" />

@if (games is null)
{
    <div class="loading" role="status">Spinning up…</div>
}
else
{
    <nav class="modes" role="tablist" aria-label="Game mode">
        <button class="mode @(practiceMode ? "" : "active")" role="tab" aria-selected="@(practiceMode ? "false" : "true")" @onclick="() => SwitchMode(false)">Daily</button>
        <button class="mode @(practiceMode ? "active" : "")" role="tab" aria-selected="@(practiceMode ? "true" : "false")" @onclick="() => SwitchMode(true)">Practice</button>
    </nav>

    <section class="intro">
        @if (practiceMode)
        {
            <p class="tagline">Practice round. Random blades, as many rounds as you like. Nothing here counts toward your stats.</p>
            <p class="meta">@games.Pool.Count blades in the pool</p>
        }
        else
        {
            <p class="tagline">Guess today's <strong>Beyblade X</strong> blade.</p>
            <p class="meta">Blade #@games.DayNumber · @games.Today.ToString("d MMM yyyy") · @games.Pool.Count blades in the pool</p>
        }
    </section>

    @if (debugDayOverride is not null)
    {
        <p class="debug-badge">🐞 DEBUG: viewing @DailyPicker.DayKey(games.Today) &mdash; drop <code>?day=</code> from the URL to go back to today</p>
    }

    <ol class="rounds" aria-label="Rounds">
        <li class="round-pill @(roundOneShown ? "done" : "active")" aria-current="@(!roundOneShown ? "step" : null)">1 · Blade</li>
        <li class="round-arrow" aria-hidden="true">→</li>
        <li class="round-pill @(game.Image.Won ? "done" : roundOneShown ? "active" : "")" aria-current="@(roundOneShown && !game.Image.Won ? "step" : null)">2 · Image</li>
    </ol>

    <XtremeToggle Game="game" OnToggle="ToggleXtremeMode" />

    @if (roundOneShown)
    {
        <RoundOneResult Game="game" Pool="games.Pool" Today="games.Today" Left="Left" />

        <ImageRoundPanel Game="game" Pool="games.Pool" Missing="missing">
            @if (practiceMode)
            {
                <button class="btn primary" @onclick="NewPractice">Next round</button>
            }
            <button class="btn @(practiceMode ? "" : "primary")" @onclick="Share">@(copied ? "Copied!" : "Share result")</button>
            <button class="btn" @onclick="ShareImage">@(imageShareStatus ?? "Share image")</button>
            @if (!practiceMode)
            {
                <span class="countdown">Next blade in <strong>@countdown</strong></span>
            }
        </ImageRoundPanel>
    }

    @if (!game.Complete)
    {
        <GuessBox @ref="guessBox" Game="game" Pool="games.Pool" Left="Left" Revealing="revealing" EggReply="@eggReply"
                  OnSubmit="Submit" OnTyped="OnTyped" />
    }

    <GuessBoard Guesses="game.Blade.Guesses" Left="Left" Revealing="revealing" ShowTitle="roundOneShown" />

    <AboutSection />

    <SiteFooter />
}

@if (dialog == Dialog.Help)
{
    <HelpDialog OnClose="CloseDialog" />
}
else if (dialog == Dialog.Stats && games is not null)
{
    <StatsDialog Stats="games.Stats" Unlocked="games.State.Achievements" Today="games.Today" OnClose="CloseDialog" />
}

<AchievementToast Achievement="toast" />

@code {
    private enum Dialog { None, Help, Stats }

    /// <summary>Null until the blades, schedule and saved state have loaded.</summary>
    private Games games = null!;
    private bool practiceMode;
    private GameSession game => practiceMode ? games.Practice : games.Daily;

    private GuessBox? guessBox;
    private bool focusPending;
    /// <summary>True from a winning round-1 guess until its last card has flipped; the win is hidden meanwhile.</summary>
    private bool revealing;
    private bool roundOneShown => game.Blade.Won && !revealing;
    /// <summary>Last card starts at 3.15 s and flips for 1.4 s (see .row.fresh in app.css).</summary>
    private const int RevealMs = 4700;
    /// <summary>True while the round-2 miss animation plays (see .reveal-frame.miss in app.css).</summary>
    private bool missing;
    private int missToken;
    private const int MissMs = 700;
    private Dialog dialog;
    private bool dialogFocusPending;
    private bool returnFocusPending;
    private bool copied;
    /// <summary>Button label after an image share ("Image copied!", …); null shows the default label.</summary>
    private string? imageShareStatus;
    /// <summary>Reply to a typed battle call; shown in place of the hint while the text stays in the box.</summary>
    private string? eggReply;
    private Achievement? toast;
    private readonly Queue<Achievement> toastQueue = new();
    /// <summary>True while ShowToastsAsync works through the queue, including the pause between two toasts.</summary>
    private bool showingToasts;
    private string countdown = "";
    private System.Threading.Timer? timer;

    // Debug-only date override: append ?day=yyyy-MM-dd to the URL to preview a specific day's puzzle.
    // The query-string plumbing below is compiled out of Release builds, so it does not exist in the
    // published site and cannot be triggered there. debugDayOverride stays null in Release, which is
    // all StartDay/Tick/the markup need to know to behave exactly as before.
#if DEBUG
    [Parameter]
    [SupplyParameterFromQuery(Name = "day")]
    public string? DebugDayQuery { get; set; }
#endif
    private DateOnly? debugDayOverride = null;
    private DateOnly CurrentDay() => debugDayOverride ?? DailyPicker.Today();

    protected override async Task OnInitializedAsync()
    {
        var pool = await Blades.GetAllAsync();
        var schedule = await Blades.GetScheduleAsync();
        var state = await Storage.LoadAsync();
#if DEBUG
        if (DateOnly.TryParse(DebugDayQuery, out var parsedDebugDay)) debugDayOverride = parsedDebugDay;
#endif
        games = new Games(pool, schedule, state);
        StartDay();
        NewPractice();
        timer = new System.Threading.Timer(_ => InvokeAsync(Tick), null, 0, 1000);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (games is null) return;
        if (dialogFocusPending)
        {
            dialogFocusPending = false;
            return;
        }
        if (game.Complete) return;
        if (firstRender || focusPending || returnFocusPending)
        {
            focusPending = false;
            returnFocusPending = false;
            if (guessBox is not null) await guessBox.FocusAsync();
        }
    }

    private void StartDay()
    {
        copied = false;
        if (games.StartDay(CurrentDay())) _ = CheckDailyAchievementsAsync();
        UpdateCountdown();
    }

    private void NewPractice()
    {
        games.NewPractice();
        ResetInput();
    }

    private void SwitchMode(bool toPractice)
    {
        if (practiceMode == toPractice) return;
        practiceMode = toPractice;
        ResetInput();
    }

    private void ResetInput()
    {
        guessBox?.Clear();
        eggReply = null;
        copied = false;
        imageShareStatus = null;
        revealing = false;
        missing = false;
        focusPending = true;
    }

    private void Tick()
    {
        var before = games.Today;
        UpdateCountdown();
        if (CurrentDay() != before)
        {
            StartDay();
            ResetInput();
        }
        StateHasChanged();
    }

    private void UpdateCountdown()
    {
        var t = DailyPicker.UntilNextDay();
        countdown = $"{(int)t.TotalHours:00}:{t.Minutes:00}:{t.Seconds:00}";
    }

    private async Task OnTyped(GuessBox.Typed typed)
    {
        eggReply = typed.HasMatches ? null : Achievements.Reply(typed.Text);
        if (eggReply is not null) await UnlockAsync(Achievements.LetItRip);
    }

    private async Task Submit(Blade blade)
    {
        var g = game;
        eggReply = null;

        if (g.Rejects(blade) is string why)
        {
            eggReply = $"Xtreme mode: {why}";
            focusPending = true;
            return;
        }
        var inImageRound = g.InImageRound;
        if (!g.Submit(blade)) return;
        if (debugDayOverride is null) _ = Reporter.ReportAsync(games.Today, practiceMode, g, blade, inImageRound);
        var justWonRoundOne = !inImageRound && g.Blade.Won;
        if (!inImageRound) _ = WarmUpBotLater(g.Blade.Answer);
        if (justWonRoundOne)
        {
            revealing = true;
            _ = FinishRevealLater(g);
        }
        if (inImageRound && blade.Id == g.Blade.Answer.Id) eggReply = "That one was round 1. Look at the picture.";
        if (inImageRound && !g.Image.Won)
        {
            missing = true;
            _ = EndMissLater(++missToken);
        }

        if (practiceMode)
        {
            if (g.Complete && games.FinishPracticeRound()) await UnlockAsync(Achievements.Grinder);
        }
        else
        {
            games.RecordDailyGuess(blade, inImageRound);
            await Storage.SaveAsync(games.State);
            // A round-1 win waits for the cards to flip (see FinishRevealLater) so the toast does not spoil it.
            if (!justWonRoundOne) await CheckDailyAchievementsAsync();
        }
        if (!g.Complete) focusPending = true;
    }

    /// <summary>
    /// Runs Beydle Bot while the new row's cards turn (a compositor animation a busy thread does not stall), so its
    /// one slow step does not hold up the round-1 reveal later. Cached, so later guesses cost nothing.
    /// </summary>
    private async Task WarmUpBotLater(Blade answer)
    {
        await Task.Delay(300);
        Deduction.BotGuesses(games.Pool, answer);
    }

    private async Task EndMissLater(int token)
    {
        await Task.Delay(MissMs);
        if (token != missToken) return; // a newer miss restarted the animation
        missing = false;
        StateHasChanged();
    }

    private async Task FinishRevealLater(GameSession forGame)
    {
        await Task.Delay(RevealMs);
        if (ReferenceEquals(forGame, games.Daily)) await CheckDailyAchievementsAsync();
        if (!ReferenceEquals(game, forGame)) return; // player switched mode; ResetInput already cleared the flag
        revealing = false;
        focusPending = true;
        StateHasChanged();
    }

    /// <summary>Unlocking is idempotent, so this can run after every daily guess.</summary>
    private async Task CheckDailyAchievementsAsync()
    {
        foreach (var a in games.EarnedDaily().ToList())
            await UnlockAsync(a);
    }

    private async Task UnlockAsync(Achievement a)
    {
        if (!games.Unlock(a)) return;
        await Storage.SaveAsync(games.State);
        toastQueue.Enqueue(a);
        if (!showingToasts) _ = ShowToastsAsync();
    }

    private async Task ShowToastsAsync()
    {
        showingToasts = true;
        while (toastQueue.TryDequeue(out var next))
        {
            toast = next;
            StateHasChanged();
            await Task.Delay(AchievementToast.DurationMs);
            toast = null;
            StateHasChanged();
            await Task.Delay(300);
        }
        showingToasts = false;
    }

    private async Task ToggleXtremeMode()
    {
        if (game.XtremeModeLocked) return;
        var on = games.ToggleXtremeMode(game);
        if (!on && eggReply?.StartsWith("Xtreme mode:") == true)
            eggReply = null;
        await Storage.SaveAsync(games.State);
        focusPending = true;
    }

    private (BladeRound? Round, int Count, int[] Left) leftMemo;

    /// <summary>Blades still possible after each round-1 guess of the active game. Recomputed only when a guess is added.</summary>
    private int[] Left
    {
        get
        {
            var r = game.Blade;
            if (leftMemo.Round != r || leftMemo.Count != r.Guesses.Count)
                leftMemo = (r, r.Guesses.Count, Deduction.RemainingAfterEach(games.Pool, r.Guesses));
            return leftMemo.Left;
        }
    }

    private void OpenDialog(Dialog which)
    {
        dialog = which;
        dialogFocusPending = true;
    }

    private void CloseDialog()
    {
        if (dialog == Dialog.None) return;
        dialog = Dialog.None;
        returnFocusPending = true;
    }

    private string ShareTitle => practiceMode ? "Beydle practice" : $"Beydle #{games.DayNumber}";

    private async Task Share()
    {
        copied = await Sharing.CopyToClipboardAsync(game.ShareText(ShareTitle, Nav.BaseUri));
        if (!copied) return;
        await Task.Delay(2000);
        copied = false;
    }

    private async Task ShareImage()
    {
        var status = await Sharing.ShareImageAsync(game.ToShareCard(ShareTitle, new Uri(Nav.BaseUri).Host, Left));
        imageShareStatus = status switch { "shared" => "Shared!", "copied" => "Image copied!", "saved" => "Image saved!", "failed" => "Couldn't share", _ => null };
        if (imageShareStatus is null) return;
        StateHasChanged();
        await Task.Delay(2000);
        imageShareStatus = null;
    }

    public void Dispose() => timer?.Dispose();
}

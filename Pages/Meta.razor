@page "/meta"
@inject MetaService MetaData

<PageTitle>Beyblade X tournament meta - Beydle</PageTitle>

<TopBar OnMetaPage="true" />

<section class="intro">
    <h1 class="tagline">What wins <strong>Beyblade X</strong> tournaments</h1>
    <MetaSubtitle Through="@(loaded == true ? board.Anchor : null)" />
</section>

@if (loaded != true)
{
    <MetaLoading Failed="loaded == false" />
}
else
{
    <nav class="modes meta-tabs" role="tablist" aria-label="Rank by">
        @foreach (var v in Enum.GetValues<MetaView>())
        {
            <button class="mode @(v == view ? "active" : "")" role="tab" aria-selected="@(v == view ? "true" : "false")" @onclick="() => SetView(v)">@v</button>
        }
    </nav>

    var shown = Shown;
    <div class="meta-toolbar">
        <MetaWindowSelect Value="@window" ValueChanged="SetWindow" />
        <input class="search-input meta-search" type="search" placeholder="Search @Plural…" aria-label="Search @Plural"
               value="@search" @oninput="e => SetSearch((string?)e.Value)" />
        <span class="meta-count">@shown.Count @Plural</span>
    </div>

    <div class="lb-row lb-head @(HasPages ? "with-open" : "")" aria-hidden="true">
        <span class="lb-rank">#</span>
        <span class="lb-name">@Singular</span>
        <span class="lb-n" title="1st place">🥇</span>
        <span class="lb-n" title="2nd place">🥈</span>
        <span class="lb-n" title="3rd place">🥉</span>
        <span class="lb-n">Total</span>
        <span class="lb-score">Score</span>
        <span class="lb-move" title="Change against the previous period">+/−</span>
    </div>
    <ol class="leaderboard" aria-label="@view ranked by score">
        @foreach (var r in shown.Take(limit))
        {
            var open = expanded.Contains(r.Name);
            <li class="lb-entry @(open ? "open" : "") @(HasPages ? "with-open" : "")" @key="r.Name">
                @if (HasDetail)
                {
                    <button class="lb-row" aria-expanded="@(open ? "true" : "false")" aria-label="@Spoken(r)" @onclick="() => Toggle(r.Name)">@RowCells(r)</button>
                }
                else
                {
                    <div class="lb-row" aria-label="@Spoken(r)">@RowCells(r)</div>
                }
                @if (HasPages)
                {
                    @if (slugs.TryGetValue(r.Name, out var pageSlug))
                    {
                        <a class="lb-open" href="meta/@pageSlug" title="Open the @r.Name page" aria-label="Open the @r.Name page">
                            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8.6 16.6 13.2 12 8.6 7.4 10 6l6 6-6 6z" /></svg>
                        </a>
                    }
                    else
                    {
                        <span class="lb-open" aria-hidden="true"></span>
                    }
                }
                @if (open)
                {
                    <div class="lb-detail">
                        <h3>@(view == MetaView.Decks ? "Exact line-ups run with this deck" : $"Top combos with this {Singular.ToLowerInvariant()}")</h3>
                        <MetaRowList Rows="board.CombosFor(view, window, r.Name)" />
                        @if (view == MetaView.Blades && slugs.TryGetValue(r.Name, out var slug))
                        {
                            <a class="lb-page-link" href="meta/@slug">All @r.Name stats →</a>
                        }
                    </div>
                }
            </li>
        }
    </ol>

    @if (shown.Count > limit)
    {
        <div class="meta-more"><button class="btn" @onclick="() => limit += PageSize">Show @Math.Min(PageSize, shown.Count - limit) more</button></div>
    }

    <MetaSourceNote />
}

<SiteFooter />

@code {
    private const int PageSize = 25;

    /// <summary>Null while the data loads, false when it could not.</summary>
    private bool? loaded;
    private MetaLeaderboard board => MetaData.Board;
    /// <summary>Blade name to the slug of its page, for the blades that have one.</summary>
    private Dictionary<string, string> slugs = [];
    private MetaView view = MetaView.Blades;
    private string window = MetaLeaderboard.DefaultWindow;
    private string? search;
    private int limit = PageSize;
    private readonly HashSet<string> expanded = [];
    /// <summary>The ranking for the current view and window, recomputed only when either changes.</summary>
    private IReadOnlyList<MetaRow> rows = [];
    private List<MetaRow> Shown => string.IsNullOrWhiteSpace(search)
        ? rows.ToList()
        : rows.Where(r => r.Name.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();

    private bool HasDetail => view != MetaView.Combos;
    /// <summary>Blades link to their own pages from a button at the end of the row.</summary>
    private bool HasPages => view == MetaView.Blades;
    private string Plural => view.ToString().ToLowerInvariant();
    private string Singular => view == MetaView.Decks ? "Deck" : view.ToString().TrimEnd('s');

    protected override async Task OnInitializedAsync()
    {
        loaded = await MetaData.LoadAsync();
        if (loaded != true) return;
        slugs = MetaData.Pages.ToDictionary(p => p.Name, p => p.Slug);
        if (board.Anchor is null) window = "all";
        Recompute();
    }

    private void Recompute()
    {
        rows = board.Rank(view, window);
        expanded.Clear();
        limit = PageSize;
    }

    private void SetView(MetaView v)
    {
        if (v == view) return;
        view = v;
        Recompute();
    }

    private void SetWindow(string w)
    {
        window = w;
        Recompute();
    }

    private void SetSearch(string? text)
    {
        search = text;
        limit = PageSize;
    }

    private void Toggle(string name)
    {
        if (!HasDetail) return;
        if (!expanded.Remove(name)) expanded.Add(name);
    }

    private static string Spoken(MetaRow r) =>
        $"{r.Rank}. {r.Name}: score {r.Score}, {r.First} first, {r.Second} second, {r.Third} third" + (r.TrendSpoken is { } t ? $", {t}" : "");

    private static RenderFragment RowCells(MetaRow r) =>
        @<text>
            <span class="lb-rank">@r.Rank</span>
            <span class="lb-name">@r.Name</span>
            <span class="lb-n">@r.First</span>
            <span class="lb-n">@r.Second</span>
            <span class="lb-n">@r.Third</span>
            <span class="lb-n">@r.Total</span>
            <span class="lb-score">@r.Score</span>
            <span class="lb-move @r.Trend">@r.TrendText</span>
            <span class="lb-sub">🥇@r.First 🥈@r.Second 🥉@r.Third · @r.Total top-3</span>
        </text>;
}
